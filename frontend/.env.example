NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# Server-side (RSC/actions) no Compose — hostname interno do serviço backend
# ARCHLENS_API_INTERNAL_URL=http://backend:8080/api/v1
API_TIMEOUT_MS=30000

# NextAuth
AUTH_SECRET=change-me-in-production-min-32-chars
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Keycloak / OIDC (ambiente integrado)
KEYCLOAK_ISSUER=http://localhost:8081/realms/archlens
KEYCLOAK_CLIENT_ID=archlens-frontend
KEYCLOAK_CLIENT_SECRET=archlens-frontend-secret

# Login local somente quando explicitamente habilitado (dev/teste/demo).
# Senhas de demonstração exigem ARCHLENS_ALLOW_DEMO_CREDENTIALS=true.
# Perfil production desliga o login local mesmo que AUTH_LOCAL_ENABLED=true.
AUTH_LOCAL_ENABLED=true
ARCHLENS_ALLOW_DEMO_CREDENTIALS=true
ARCHLENS_PROFILE_LABEL=demo
AUTH_LOCAL_ADMIN_PASSWORD=admin123
AUTH_LOCAL_ARCHITECT_PASSWORD=architect123
AUTH_LOCAL_VIEWER_PASSWORD=viewer123

# Opcional (não use secrets em NEXT_PUBLIC_*)
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8081/realms/archlens
NEXT_PUBLIC_OIDC_CLIENT_ID=archlens-frontend
